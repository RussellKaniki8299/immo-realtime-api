PORT=3000

# Origines autorisées (séparées par des virgules). Ne PLUS laisser "*" en production.
CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Secret partagé avec Laravel (REALTIME_INTERNAL_SECRET côté Laravel). Protège /api/realtime/chat-*, call-event, unread-count…
INTERNAL_API_SECRET=change-me-long-random-string

# Authentification des sockets : none | laravel
#  - none    : comportement actuel (le client annonce son userId)
#  - laravel : le token Sanctum du client est vérifié auprès de Laravel (recommandé)
SOCKET_AUTH_MODE=none
LARAVEL_API_URL=https://api.example.com
LARAVEL_AUTH_ENDPOINT=/api/user
