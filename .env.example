PORT=3000
NODE_ENV=production

# Origines autorisées (séparées par des virgules). Vide = *
CORS_ORIGINS=https://kinmak.net,https://admin.kinmak.net

# Secret partagé avec Laravel (INTERNAL_API_SECRET côté Laravel — même valeur)
INTERNAL_API_SECRET=change-me

# none    : join_user fait confiance au client (migration)
# laravel : le client fournit son jeton Sanctum (io(URL, { auth: { token } })), vérifié auprès de Laravel
SOCKET_AUTH_MODE=laravel
LARAVEL_API_URL=https://api.kinmak.net
LARAVEL_AUTH_ENDPOINT=/api/user

# true = les routes métier (/new-order, /order-status-updated…) exigent aussi x-internal-secret.
# À activer quand TOUS les appels Laravel passent par RealtimeService (envoie l'en-tête).
PROTECT_BUSINESS_ROUTES=false
